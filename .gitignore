# ── Large ROM images (user-provided, device-specific) ────────────────────────
payload.bin
payload_(or)_ROM-file/*
!payload_(or)_ROM-file/.gitkeep
input/*
!input/.gitkeep
output/*
!output/.gitkeep

# ── APKs (user-provided, third-party binaries, too large for git) ─────────────
product/**/*.apk

# ── Generated per-device protection XMLs (device/app-specific, not portable) ──
product/etc/permissions/*.xml
!product/etc/permissions/.gitkeep

# ── Build artifacts ───────────────────────────────────────────────────────────

# ── Python cache ──────────────────────────────────────────────────────────────
tools/__pycache__/
**/__pycache__/
*.pyc

# ── Run logs ──────────────────────────────────────────────────────────────────
Logs/

# ── Session/tool private state ────────────────────────────────────────────────
.remember/

# ── Personal files ────────────────────────────────────────────────────────────
*.jpeg
*.jpg
*.png
