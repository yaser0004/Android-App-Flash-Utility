mkdir product/app/AppName
cp base.apk split_config.arm64_v8a.apk product/app/AppName/
# Copy all .apk files — script auto-skips wrong-architecture splits

# Update: cp new-version.apk product/app/AppName/AppName.apk
# Remove: rm -rf product/app/AppName

# ── INJECT + FLASH ───────────────────────────────────────────────────────────

